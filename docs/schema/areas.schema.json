{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ascend.local/schema/areas.schema.json",
  "title": "Ascend areas file (coffee_shop.geojson / eatery.geojson)",
  "description": "Data contract v1.0.0 between the pipeline (07_export) and the web app. In Phase 2 this is also the response body of GET /areas?business_type=<type>.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "contract_version", "business_type", "is_sample", "generated_at", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "contract_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "Semver. The web app must refuse files with a different major version."
    },
    "business_type": { "enum": ["coffee_shop", "eatery"] },
    "is_sample": {
      "type": "boolean",
      "description": "true = synthetic sample data. The UI must show a 'Sample data' badge."
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "description": "[longitude, latitude], rounded to 5 decimals."
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": { "$ref": "#/$defs/position" }
              }
            }
          }
        },
        "properties": { "$ref": "#/$defs/area_properties" }
      }
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "text", "effect"],
      "properties": {
        "feature": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Internal feature name, e.g. pop_k1. Not shown in the UI."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Plain-English reason shown in the UI, e.g. 'Many residents nearby'."
        },
        "effect": {
          "type": "number",
          "description": "SHAP value on the log scale. Use only its sign (arrow) and order. Never show the number."
        }
      }
    },
    "area_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h3", "kecamatan", "area_name",
        "actual", "expected", "actual_k1", "expected_k1",
        "gap", "p_value", "label", "confidence", "factors"
      ],
      "properties": {
        "h3": {
          "type": "string",
          "pattern": "^89[0-9a-f]{13}$",
          "description": "H3 resolution 9 cell ID. Unique within the file. Use as MapLibre promoteId."
        },
        "kecamatan": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 40,
          "description": "District name. null = unknown; UI shows 'Unnamed area'."
        },
        "area_name": { "enum": ["kota_bandung", "telkom_area"] },
        "actual": {
          "type": "integer",
          "minimum": 0,
          "description": "Outlets mapped inside this hexagon."
        },
        "expected": {
          "type": "number",
          "minimum": 0,
          "description": "Out-of-fold model estimate for this hexagon, 1 decimal."
        },
        "actual_k1": {
          "type": "integer",
          "minimum": 0,
          "description": "Outlets in this hexagon + its 6 neighbours (about 500 m). Shown in the area card."
        },
        "expected_k1": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of out-of-fold estimates over the k-ring, 1 decimal. Shown in the area card."
        },
        "gap": {
          "type": "number",
          "description": "expected_k1 - actual_k1, 1 decimal. Positive = room for more outlets."
        },
        "p_value": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "One-sided Poisson p-value in the direction of the gap, 4 decimals. null when label is not_enough_demand. Never shown in the UI."
        },
        "label": { "enum": ["opportunity", "fair", "crowded", "not_enough_demand"] },
        "confidence": { "enum": ["normal", "low"] },
        "factors": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/factor" },
          "description": "Top 3 demand drivers for the centre hexagon, sorted by |effect| descending."
        }
      }
    }
  }
}
